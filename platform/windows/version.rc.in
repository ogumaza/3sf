// SPDX-License-Identifier: MIT

// A Windows program's version resource: Explorer shows its version and description in the file's properties. CMake
// fills it in for each program (threesf_add_version in CMakeLists.txt).

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @threesf_VERSION_MAJOR@,@threesf_VERSION_MINOR@,@threesf_VERSION_PATCH@,0
PRODUCTVERSION @threesf_VERSION_MAJOR@,@threesf_VERSION_MINOR@,@threesf_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE @VERSION_FILE_TYPE@
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "@VERSION_DESCRIPTION@"
            VALUE "FileVersion", "@threesf_VERSION@"
            VALUE "InternalName", "@VERSION_NAME@"
            VALUE "LegalCopyright", "Copyright (c) 2026 the 3SF authors. MIT licence."
            VALUE "OriginalFilename", "@VERSION_FILE_NAME@"
            VALUE "ProductName", "3SF"
            VALUE "ProductVersion", "@threesf_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
